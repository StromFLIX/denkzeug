# Generated by scripts/sync_rust_broker_staging.py; do not edit directly.
# Rust HTTP runtime; Python/sh retained only for trusted Coolify maintenance hooks.
# Build from the repository root. The default target is socket-free smoke.
# The explicit candidate target is for isolated migration/compatibility runs.
FROM rust:1.100.0-bookworm AS compile
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends musl-tools && rm -rf /var/lib/apt/lists/*
WORKDIR /work/services/docker-broker-rust
COPY services/docker-broker-rust/Cargo.toml services/docker-broker-rust/Cargo.lock ./
COPY services/docker-broker-rust/src/ ./src/
COPY images/pi-base/artcraft/catalog.json /work/images/pi-base/artcraft/catalog.json
COPY services/docker-broker/nautionette_docker_broker/artcraft_offline.py /work/services/docker-broker/nautionette_docker_broker/artcraft_offline.py
RUN set -eu; \
    case "${TARGETARCH:-$(uname -m)}" in \
      amd64|x86_64) target=x86_64-unknown-linux-musl ;; \
      arm64|aarch64) target=aarch64-unknown-linux-musl ;; \
      *) echo "Unsupported architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    rustup target add "$target"; \
    TARGET_CC=musl-gcc RUSTFLAGS='-C linker=rust-lld' cargo build --locked --release --target "$target"; \
    cp "target/$target/release/denkzeug-docker-broker-spike" /broker; \
    install -d -m 1777 /runtime/root-owned/tmp; \
    install -d -m 0755 /runtime/shared/projects; \
    install -d -m 0700 /runtime/shared/chat-sessions

FROM python:3.13.18-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.13.9 /uv /uvx /usr/local/bin/
RUN apt-get update && apt-get upgrade -y --no-install-recommends && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH"
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY libs/nautionette/ libs/nautionette/
COPY services/backend/pyproject.toml services/backend/
COPY services/workflow-mcp/pyproject.toml services/workflow-mcp/
COPY services/worker/pyproject.toml services/worker/
COPY services/docker-broker/ services/docker-broker/
RUN uv sync --locked --no-dev --package nautionette-docker-broker
# Either service may be the first to populate the shared named volume. Keep its
# root writable by the non-root backend, not just by this privileged broker.
RUN mkdir -p /projects /chat-sessions \
    && chown 10001:10001 /projects /chat-sessions \
    && chmod 700 /chat-sessions

# The broker carries the build contexts so pruned Pi images can be rebuilt.
COPY images/ /agent-images/
# Coolify injects ARG declarations into Dockerfiles before this COPY. The
# CI-checked lock keeps registry identities tied to canonical repository source.
COPY images/source-fingerprints.json /etc/nautionette/image-fingerprints.json
COPY images/pi-base/artcraft/catalog.json /etc/nautionette/artcraft-catalog.json

# Runs as root: it needs the Docker socket. The API surface stays fixed instead.
EXPOSE 9100
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=5 \
    CMD python -c "import json,sys,urllib.request;sys.exit(json.load(urllib.request.urlopen('http://127.0.0.1:9100/healthz',timeout=4))['status'] != 'ok')"
COPY --from=compile /broker /broker
ENV BROKER_BIND_ADDR=0.0.0.0 BROKER_PORT=9100 BROKER_DOCKER_SOCKET=/var/run/docker.sock
CMD ["/broker", "--local-runtime"]
